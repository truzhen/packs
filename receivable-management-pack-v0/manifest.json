{
  "pack_id": "pack_receivable_management_v0",
  "pack_ref": "scene_pack://receivable-management",
  "version": "0.1.0",
  "kind": "scene_pack",
  "min_truzhen_version": "3.0.0",
  "lifecycle_status": "设计中",
  "name": "应收管理 Pack（账龄巡检与催办候选）",
  "template_family": "应收账款催办治理型",
  "description": "应收账款管理场景荚：账龄巡检（只读账龄快照）→ 应收顾问出催办建议 → 生成催办草稿候选（中性事实性话术，经沟通网关策略裁剪）→ Owner 主权裁定是否发送 → 归档。催办时段、频次、话术白名单与禁用词一票否决为 os 侧硬编码产品默认值，本荚只做知识陈述与流程声明；Pack 只出候选，不发送、不执行、不持主权。",
  "author": "Truzhen Pack Studio (用户视角制作)",
  "pack_type": "domain_work_pack",
  "manifest_version": "v3",
  "target_industry": "中小企业应收账款管理 / 财务与商务催收",
  "target_audience": "企业主、财务负责人、商务与销售内勤",
  "flow_spec_ref": "scene_flow_spec:receivable-dunning@1.0.0",
  "flow_file": "flows/receivable-dunning.flow.json",
  "role_slots_file": "role-slots/role-slots.json",
  "capabilities_file": "capabilities/capabilities.json",
  "knowledge_scopes_manifest": "knowledge/knowledge-scopes.json",
  "knowledge_index": "knowledge/knowledge-index.json",
  "knowledge_scopes": [
    "knowledge_scope://receivable/dunning"
  ],
  "knowledge_disclaimer": "本 pack 的 knowledge/ 内容为 Pack 作者合成撰写的中性催办话术模板、禁用词表与作业口径，不含任何真实客户、金额、人名或单据；每条以 verification_status=pending_human_review 入库。催办涉及债权催收合规风险，正式对外使用前必须经 Owner / 法务逐条核验，并以现行有效法律法规与合同原文为准。时段、频次、话术白名单与禁用词一票否决的真相与执行在 os 侧沟通网关，本荚知识只是陈述，不构成第二真相源。",
  "security_profile": {
    "candidate_only": true,
    "non_formal": true,
    "requires_base_gate": true,
    "requires_receipt_candidate": true,
    "default_provider_mode": "disabled",
    "no_real_send": true,
    "no_real_execute": true,
    "no_real_model_call": false,
    "isolated_namespace": "receivable_management_ns"
  },
  "role_slots": [
    {
      "slot_id": "receivable_advisor",
      "responsibility": "应收顾问：依据账龄快照给出催办优先级与催办建议候选（Proposer）",
      "node_type": "advice",
      "default_role_pack_ref": "role_pack:receivable_advisor@1.0.0"
    }
  ],
  "capabilities_required": [
    "accounting.get_receivable_summary",
    "accounting.list_invoices",
    "truzhen.communication.draft"
  ],
  "required_capabilities": [
    "accounting.get_receivable_summary",
    "accounting.list_invoices",
    "truzhen.communication.draft"
  ],
  "gates": {
    "state_transition_gate": "base_gate",
    "communication_send_gate": "base_send_gate",
    "invoice_write_gate": "base_execution_gate"
  },
  "gate_flags": [
    "dunning_message_send_confirm",
    "payment_plan_change_confirm",
    "invoice_write_candidate_confirm",
    "formal_memory_confirm"
  ],
  "receipt_policy": {
    "ledger_group": "receivable_management_dunning",
    "append_only": true,
    "requires_witness": true
  },
  "person_strategy": {
    "summary": "判人策略：应收顾问为 Proposer（只出催办优先级与话术建议候选，无正式裁定权，不得代 Owner 承诺减免、账期或付款计划）；催办消息发送、付款计划变更、单据写回候选、正式记忆入库属高风险正式动作，一律回 Owner + Base Gate 裁定，不得由角色 agent 自决，也不得委托。",
    "proposer_roles": [
      "receivable_advisor"
    ],
    "high_risk_actions_return_to_owner": [
      "dunning_message_send_confirm",
      "payment_plan_change_confirm",
      "invoice_write_candidate_confirm",
      "formal_memory_confirm"
    ],
    "delegation_allowed": false
  },
  "formalization_requirement": {
    "summary": "判事策略：账龄巡检、催办建议、催办草稿均为候选态（candidate_only / non_formal）；催办草稿永远只是 CommunicationDraftCandidate，被策略裁剪为 blocked 时仍是候选，不得包装成已发送。唯有催办消息对外发送、付款计划变更、单据写回、正式记忆入库需经 Owner 主权确认 + Base Gate 裁定后才正式化并产可在 03 反查的 Receipt。裁定权在 Base，不在场景包。",
    "formalizes": [
      "CommunicationSend",
      "PaymentPlanChange",
      "InvoiceWrite",
      "FormalReceipt"
    ],
    "decided_by": "owner_plus_base_gate"
  },
  "provider_requirements": [
    {
      "requirement_id": "receivable_snapshot_readonly",
      "capability": "accounting.get_receivable_summary",
      "gateway_class": "execution",
      "risk_class": "low",
      "binding": "registry_to_gateway_to_base",
      "fallback_policy": "blocked",
      "provider_family": "frappe",
      "description": "应收事实来源 = Frappe / ERPNext Sales Invoice 只读快照（docstatus=1）；只读取、不写回。快照缺失或 Provider 未接通时诚实 blocked，不得用 fixture、模板或估算冒充账龄事实。"
    },
    {
      "requirement_id": "receivable_invoice_list_readonly",
      "capability": "accounting.list_invoices",
      "gateway_class": "execution",
      "risk_class": "low",
      "binding": "registry_to_gateway_to_base",
      "fallback_policy": "blocked",
      "provider_family": "frappe",
      "description": "按客户 / 币种 / 账期列出应收单据的只读查询；同一 Sales Invoice 只读快照来源，缺失即 blocked。"
    },
    {
      "requirement_id": "dunning_message_draft_channel",
      "capability": "truzhen.communication.draft",
      "gateway_class": "communication",
      "risk_class": "high",
      "binding": "registry_to_gateway_to_base",
      "fallback_policy": "not_ready",
      "provider_family": "external_communication_hands",
      "description": "催办消息 1:1 会话草稿通道；Pack 不实现通道、不发送。未接通时 not_ready，发送仍须 Owner + Base Gate。"
    }
  ],
  "notification_command_report_routes": {
    "notification": [
      "owner_dashboard",
      "pack.candidate.card"
    ],
    "command_candidate": [
      "pack.task.panel",
      "dunning_send_confirm_card"
    ],
    "report": [
      "candidate_review",
      "receipt_ledger",
      "pack.receipt.timeline"
    ]
  },
  "report_routes": [
    "candidate_review",
    "receipt_ledger"
  ],
  "evidence_requirements": {
    "summary": "证据要求：每次催办发送必须绑定可在 03 反查的 Receipt，OwnerActionEvidence = Owner 五要素确认点击；催办频次判定必须以既有沟通回执账本按单据号反查为证据源，不得建平行计数真相，反查不可用时 fail-closed 为 blocked 而非放行。",
    "requires_receipt_ref": true,
    "requires_owner_action_evidence": true,
    "receipt_lookup_module": "03-receipt-ledger"
  },
  "multi_role_comparison": {
    "summary": "本 Pack 单角色（应收顾问）经 advice 节点提出催办建议候选，催办草稿与发送分别回沟通网关策略与 Owner/Base Gate；对照与裁定为显式流程节点，禁 runtime 内隐藏 agent 间回路。",
    "explicit_nodes": [
      "advisor_advice(receivable_advisor/advice)",
      "owner_approval(human_approval)"
    ],
    "hidden_agent_loops_forbidden": true
  },
  "moat_justification": {
    "question": "用户能否一句话让最强模型直接做出同样结果？",
    "passes_moat": true,
    "valid_reasons": [
      "real_system_integration",
      "domain_approval_compliance",
      "auditable_evidence_receipt",
      "transaction_lifecycle_replay"
    ],
    "rationale": "应收催办依赖真实 ERPNext Sales Invoice 只读快照的账龄投影、催办时段/频次/话术白名单/禁用词一票否决的受控裁剪、Owner + Base Gate 的发送主权确认，以及每次催办可在 03 反查的回执与按单据号的历史回放——不是单次 prompt 可替代的文本生成；最强模型既拿不到用户的真实应收事实，也无法留下可审计的发送证据。"
  },
  "ui_surface_slots": [
    "pack.dashboard",
    "pack.object.list",
    "pack.object.detail",
    "pack.flow.canvas",
    "pack.task.panel",
    "pack.candidate.card",
    "pack.receipt.timeline",
    "transaction.capsule"
  ],
  "forbidden_artifacts": [
    "node_modules",
    "dist",
    "build",
    ".vite",
    "*.db",
    "*.sqlite",
    "*.log",
    "*.jsonl"
  ],
  "software_requirements": [
    {
      "requirement_id": "receivable-frappe-runtime",
      "software_family": "frappe-erpnext-stack",
      "provider_family": "frappe",
      "version_range": ">=16.0.0,<17.0.0",
      "required_capabilities": [
        "accounting.get_receivable_summary",
        "accounting.list_invoices"
      ],
      "license_policy": "review_required",
      "isolation_policy": "reuse_preferred",
      "fallback_policy": "blocked",
      "gateway_class": "execution",
      "risk_class": "medium"
    },
    {
      "requirement_id": "receivable-communication-hands",
      "software_family": "external-communication-hands-family",
      "provider_family": "external_communication_hands",
      "version_range": ">=0.1.0,<1.0.0",
      "required_capabilities": [
        "truzhen.communication.draft"
      ],
      "license_policy": "review_required",
      "isolation_policy": "reuse_preferred",
      "fallback_policy": "not_ready",
      "optional": true,
      "gateway_class": "communication",
      "risk_class": "high"
    }
  ]
}
